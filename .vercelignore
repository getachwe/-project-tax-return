# api/[[...path]].js – catch-all ל-Express (פונקציה יחידה)
# api-legacy – הקבצים הישנים, לא נשלחים

api-legacy/

# Ignore development files
node_modules/
*.log
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore build artifacts that shouldn't be deployed
backend/temp/
backend/uploads/
backend/pdfs/
project/uploads/

# Ignore test files
**/*.test.js
**/*.test.ts
**/test-*.js

# Ignore development tools
.eslintrc*
.prettierrc*

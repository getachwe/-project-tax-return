{
  "builds": [
    {
      "src": "project/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "backend/package.json", 
      "use": "@vercel/node"
    }
  ],
  
  "rewrites": [
    { "source": "/api/auth/callback", "destination": "/backend/api/index.js" },
    
    { "source": "/api/(.*)", "destination": "/backend/api/index.js" },
    
    { "source": "/assets/(.*)", "destination": "/project/dist/assets/$1" },

    { "source": "/(.*)", "destination": "/project/dist/index.html" }
  ]
}
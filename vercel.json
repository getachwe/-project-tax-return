{
  "builds": [
    {
      "src": "project/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.js" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/project/dist/index.html" }
  ]
}

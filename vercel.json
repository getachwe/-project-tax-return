{
  "builds": [

    {
      "src": "project/package.json",
      "use": "@vercel/static-build"
    },
   
    {
      "src": "backend/package.json", 
      "use": "@vercel/node"
    }
  ],
  "routes": [
  
    { 
      "src": "/api/(.*)", 
      "dest": "backend/api/index.js" 
    },
   
    { 
      "src": "/(.*)", 
      "dest": "/project/dist/index.html" 
    }
  ]
}
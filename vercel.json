{
  "framework": null,
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "project/dist",
  "installCommand": "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1 npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }
      ]
    }
  ]
}
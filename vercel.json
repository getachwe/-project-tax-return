{
  "builds": [
    {
      "src": "project/package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "backend/package.json", 
      "use": "@vercel/node"
    }
  ],
  
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/project/dist/assets/$1" },
    { "src": "/(.*)", "dest": "/project/dist/index.html" }
  ]
}